Algorithme grand_test_complet

Fonction calculer_factorielle(n : entier) : entier
Debut
    Si n < 2 alors
        Retourne 1
    Sinon
        Retourne n * calculer_factorielle(n - 1)
    fin Si
Fin

Fonction evaluer_statut(moyenne : reel) : chaine
Variables
    resultat : chaine
Debut
    Si moyenne >= SEUIL_PASSAGE alors
        resultat ← "Admis"
    Sinon
        resultat ← "Ajourne"
    fin Si
    Retourne resultat
Fin

Procedure afficher_entete(titre : chaine)
Debut
    Ecrire("=== ", titre, " ===")
Fin

Procedure afficher_bilan(nom : chaine, moy : reel, stat : chaine)
Debut
    Ecrire("Etudiant : ", nom, " | Moyenne : ", moy, " | Statut : ", stat)
Fin

Constantes
    Tableau COEFF ← (2, 3)
    SEUIL_PASSAGE ← 10.0

Variables
    Tableau Notes(2, 2) : reel
    nom_etudiant : chaine
    fact : entier
    i, j : entier
    somme : reel
    moyenne_finale : reel
    statut : chaine

Debut
    afficher_entete("BILAN SEMESTRIEL")

    nom_etudiant ← "Bob"
    fact ← calculer_factorielle(3)

    Notes(0, 0) ← 12.0
    Notes(0, 1) ← 14.0
    Notes(1, 0) ← 8.0
    Notes(1, 1) ← 9.0

    somme ← 0.0

    Pour i ← 0 à 1 pas 1 faire
        Pour j ← 0 à 1 pas 1 faire
            somme ← somme + (Notes(i, j) * COEFF(j))
        fin Pour
    fin Pour

    moyenne_finale ← somme / 10.0
    statut ← evaluer_statut(moyenne_finale)

    afficher_bilan(nom_etudiant, moyenne_finale, statut)
Fin
