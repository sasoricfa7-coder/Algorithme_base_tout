algorithmes cacul_tableau
variables
	tableau T(10), i: entier
	s, p, element: entier
	m: reel

debut
	pour i ← 0 à 9 pas 1 faire
		Ecrire("T(", i+1, ") = ")
		lire(t(i))
	fin pour

	s ← 0
	p ← 1
	pour i ← 0 à 9 pas 1 faire
		element ← T(i)
		s ← s + element
		p ← p * element
	fin pour
	m ← s/10

	Ecrire("La somme = ", s)
	Ecrire("La moyenne  = ", m)
	Ecrire("Le produit = ", p)
fin
