algorithme test
fonction doubler(T: tableau entier) : tableau entier
variables
    tableau R(3): entier
    i: entier
debut
    pour i ← 0 à 2 pas 1 faire
        R(i) ← T(i) * 2
    fin pour
    retourne R
fin

fonction somme(T: tableau entier) : entier
variables
    s, i: entier
debut
    s ← 0
    pour i ← 0 à 2 pas 1 faire
        s ← s + T(i)
    fin pour
    retourne s
fin

variables
    tableau Tab(3): entier
    i: entier
debut
    pour i ← 0 à 2 pas 1 faire
        Tab(i) ← i + 1
    fin pour
    Ecrire("Somme : ", somme(doubler(Tab)))
fin
