algorithme photocopie

variables
	nombre_photocopie: entier
	prix: réel

debut
	Ecrire("Entrez le nombre de photocopie à effectuer")
	lire(nombre_photocopie)

	si nombre_photocopie <= 10 alors
		prix ← nombre_photocopie * 0.30

	sinon
		si nombre_photocopie <= 30 alors
			prix ← 10 * 0.30 + (nombre_photocopie - 10) * 0.25
		sinon
			prix ← 10 * 0.3 + 20 * 0.25 + (nombre_photocopie - 30) * 0.25
		fin si
	fin si

	Ecrire("La facture s'élève à ", prix, " franc CFA → ", nombre_photocopie, " photocopies.")
fin
