ALGORITHME ANNEE_BISSEXTILE

	FONCTION EST_BISSEXTILE(AN: ENTIER): BOOLEEN
		debut
			SI (AN MOD 400 = 0) ou ( (AN mod 4 = 0) et (AN mod 100 <> 0) ) ALORS
				RETOURNE VRAI
			SINON
				RETOURNE NON VRAI
			FIN SI
		fin

	VARIABLES
		X: ENTIER
		valide: booleen

DEBUT
	ECRIRE("ENTREZ UNE ANNÉE")
	LIRE(X)
	valide ← EST_BISSEXTILE(X)
	SI valide ALORS
		ECRIRE(valide, ", ANNEE " , X, " EST UNE ANNÉE BISSEXTILE")
	SINON
		ECRIRE(valide, ", ANNEE " , X, " N'EST PAS UNE ANNÉE BISSEXTILE")
	FIN SI
FIN
