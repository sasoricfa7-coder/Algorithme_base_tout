Algorithme croissant_decroissant %La recursivité%
	
	Procedure ordre_croissant(x: entier)
		Debut
			Si x <> 0 alors
				ordre_croissant(x - 1)
				Ecrire(x)
			fin Si
		Fin
	
	Procedure ordre_decroissant(y: entier)
		Debut
			Si y <> 0 alors
				Ecrire(y)
				ordre_decroissant(y - 1)
			fin Si
		Fin

Variables 
	n: entier 

Debut 
	Répeter 
		Ecrire("Entrez n : ")
		Lire(n)
	Jusqu'à 1 <= n
	
	Ecrire("Les nombres de 1 à ", n)
	ordre_croissant(n)
	Ecrire("Les nombres de ", n, " à 1")
	ordre_decroissant(n)
Fin 