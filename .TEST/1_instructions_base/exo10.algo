%
algorithme qui convertie une durée T en seconde : 
en heure, minute, seconde
%

algorithmes temps

debut
	Ecrire("Temps = ", 56263)
	Ecrire("Heures = ", 56263 div 3600)
	Ecrire("Minutes = ", (56263 mod 3600) div 60)
	Ecrire("Secondes = ", ((56263 mod 3600) mod 60))
fin


%algorithmes temps
constantes
t ← 56263
z ← 56263
variables
s: entier

debut
	s ← t + z
	Ecrire(t)
	Ecrire(z)
	Ecrire(s)
	
fin

%
