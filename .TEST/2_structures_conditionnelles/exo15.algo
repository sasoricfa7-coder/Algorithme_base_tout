Algorithmes mention_moyenne
variables
	n1, n2, n3, moyenne: reel
	mention: chaine
debut
	Ecrire("Entrez successivement trois notes")
	lire(n1, n2, n3)

	moyenne ← (n1 + n2 + n3) / 3
	si moyenne >= 16 alors
		mention ← "Très bien."
	sinon
		si moyenne >= 14 alors
			mention ← "Bien"
		sinon
			si moyenne >= 12 alors
				mention ← "Assez Bien"
			sinon
				si moyenne >= 10 alors
					mention ← "Passable"
				sinon
					mention ← "insuffisant"
				fin si
			fin si
		fin si
	fin si

	ecrire("moyenne = ", moyenne, " : ", mention)
fin
