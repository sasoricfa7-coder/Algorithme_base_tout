%
Ecrire un Algorithme qui remplit
un tableau 2D de dimensions (4, 6) puis l'Algorithme
determine :
	Le minimum et le maximum de chaque Ligne
	Le minimum et le maximum de chaque Colonne
%

Algorithme min_et_max

Variable
	Tableau X(4 , 6): entier
	i, j: entier
	min_l , max_l: entier
	min_c , max_c: entier

debut
	Ecrire("Remplissage du tableau : ")
	Pour i ← 0 à 3 pas 1 faire
		Pour j ← 0 à 5 pas 1 faire
			Ecrire("C(", i+1, ",", j+1, ") = ")
			Lire(X(i, j))
		fin Pour
		Ecrire()
	fin Pour

	min_l ← 0
	max_l ← 0
	min_c ← 0
	max_c ← 0

	Ecrire("Operation concernant les lignes : ")
	Pour i ← 0 à 3 pas 1 faire
		max_l <-- X(i, 0)
		min_l <-- X(i, 0)
		Pour j ← 0 à 5 pas 1 faire
			Si X(i, j) < min_l alors
				min_l ← X(i, j)
			Sinon
				Si max_l < X(i, j) alors
					max_l ← X(i, j)
				fin Si      
			fin Si
		fin Pour
		Ecrire("MAX ligne ", i + 1, " = ", max_l)
		Ecrire("MIN ligne ", i + 1, " = ", min_l)
		Ecrire()
	fin Pour

	Ecrire("Operation concernant les colonnes : ")
	Pour j ← 0 à 5 pas 1 faire
		max_c <-- X(0, j)
		min_c <-- X(0, j)
		Pour i ← 0 à 3 pas 1 faire
			Si X(i, j) < min_c alors
				min_c ← X(i, j)
			Sinon
				Si max_c < X(i, j) alors
					max_c ← X(i, j)
				fin Si      
			fin Si
		fin Pour
		Ecrire("MAX colonne ", j + 1, " = ", max_c)
		Ecrire("MIN colonne ", j + 1, " = ", min_c)
		Ecrire()
	fin Pour
fin
