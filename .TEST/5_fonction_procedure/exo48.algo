%
Ecrire un algorithme utilisant des fonctions 
ou des procedures qui demande a l'utilisateur
de saisir le rayon du cercle, puis l'algorithme
affiche le diamètre, la surface et le périmètre.
%

algorithmes element_cercle

procedure cercle(X: réel)
constantes
	PI ← 3.141592654

debut
	Ecrire("diamètre = ", X * 2)
	Ecrire("surface = ", PI * X^2)
	Ecrire("perimètre = ", 2 * PI * X)
fin

variables
	r: réel

debut
	Ecrire("Entrez le rayon")
	lire(r)
	cercle(r)
fin
