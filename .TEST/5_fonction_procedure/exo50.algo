%
Ecrire un algorithme qui demande à l'utilisateur de saisir 10 réels stocker dans un tableau.
Ecrire ensuite les fonctions et la procedure suivante : 
*trois fonctions qui permettent respectivement de calculer la somme, le produit et la moyenne
des elements du tableau.
*une procedure qui determine et affiche les elements positifs et negatifs
du tableau.
%

algorithmes calcul_tableau

fonction somme(notes_somme: Tableau réel) : réel
variables
	index: entier
	s: réel
debut
	s ← 0
	pour index ← 0 à 9 pas 1 faire
		s ← s + notes_somme(index)
	fin pour
	retourne s
fin

fonction produit(notes_produit: Tableau réel) : réel
variables
	indice: entier
	p: réel
debut
	p ← 1
	pour indice ← 0 à 9 pas 1 faire
		p ← p * notes_produit(indice)
	fin pour
	retourne p
fin

fonction la_moyenne(notes_moyenne: Tableau réel): réel
debut
	retourner somme(notes_moyenne) / 10
fin

procedure est_negatif_ou_pas(N: tableau réel)
variables
	iterateur: entier
	valide: booléen

debut
	valide ← Faux
	Ecrire("Les éléments positifs du tableau sont : ")
	pour iterateur ← 0 à 9 pas 1 faire
		si N(iterateur) >= 0 alors
			Ecrire(N(iterateur))
			valide ← Vrai
		fin si
	fin pour

	si non valide alors
		Ecrire("Aucun")
	fin si

	valide ← Faux
	Ecrire("Les éléments negatifs du tableau sont : ")
	pour iterateur ← 0 à 9 pas 1 faire
		si N(iterateur) < 0 alors
			Ecrire(N(iterateur))
			valide ← Vrai
		fin si
	fin pour

	si non valide alors
		Ecrire("Aucun")
	fin si
fin

variables
	i: entier
	tableau notes(10): réel

debut
	pour i ← 0 à 9 pas 1 faire
		Ecrire("Entrez l'élément ", i+1)
		lire(notes(i))
	fin pour

	Ecrire()
	Ecrire("la somme des éléments = ", somme(notes))
	Ecrire()
	Ecrire("le produit des éléments = ", produit(notes))
	Ecrire()
	Ecrire("la moyenne des éléments = ", la_moyenne(notes))
	Ecrire()

	est_negatif_ou_pas(notes)
fin
