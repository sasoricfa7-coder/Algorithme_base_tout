%
Ecrire un algorithme utilisant 
une fonction qui demande à l'utilisateur 
d'entrer un entier, puis l'algorithme 
compte et affiche le nombre de chiffres
qui composent cet entier.
%

algorithmes nombre_chiffre

fonction determine_nombre_chiffre(nombre: entier): entier
variables
i: entier

debut
	i ← 0
	si nombre < 0 alors
		nombre ← nombre * (-1)
	fin si
	repeter
		nombre ← nombre div 10
		i ← i + 1
	jusqu'a nombre <= 0
	retourne i
fin

variables
n: entier

debut
	Ecrire("Entrez un nombre :")
	lire(N)

	Ecrire("Le nombre ", n, " contient : ", determine_nombre_chiffre(n), " chiffres.")
fin
